# The router's firewall, rendered by chalkos-render. Loading the file replaces the table
# inet chalkos in one transaction.
table inet chalkos
delete table inet chalkos
table inet chalkos {
	chain policy-guest-out {
		accept
	}
	chain policy-internet-local {
		drop
	}
	chain policy-mgmt-local {
		tcp dport { 22 } accept
		drop
	}
	chain policy-tenant-internet {
		accept
	}
	chain ct-prerouting {
		type filter hook prerouting priority raw; policy accept;
		iifname { "eth3", "eth4", "n64-guest" } ct zone set 1 comment "VRF guest"
	}
	chain ct-output {
		type filter hook output priority raw; policy accept;
		oifname { "eth3", "eth4", "n64-guest" } ct zone set 1 comment "VRF guest"
	}
	chain prerouting {
		type filter hook prerouting priority mangle + 10; policy drop;
		meta nfproto ipv4 udp sport . udp dport { 67 . 68, 68 . 67 } accept
		iifname { "guest", "internet", "tenant" } ip6 saddr fe80::/10 ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		fib saddr . mark . iif oif exists accept
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		ct state established,related accept
		ct state invalid drop
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } accept
		ip6 daddr fe80::/64 udp sport 547 udp dport 546 accept
		iifname { "eth0" } tcp dport 50000 accept
		iifname "tenant" meta sdifname { "swp*" } tcp dport { 179 } accept comment "BGPPeer leaves"
		iifname "tenant" meta sdifname { "swp*" } udp dport { 3784, 3785 } accept comment "BGPPeer leaves"
		iifname "internet" ip saddr { 203.0.113.254/32 } tcp dport { 179 } accept comment "BGPPeer transit"
		iifname "guest" ip6 saddr { 2001:db8:3::/64 } ip6 daddr { 2001:db8:3::1/128 } udp dport { 53 } accept comment "Resolver guest"
		iifname "guest" ip6 saddr { 2001:db8:3::/64 } ip6 daddr { 2001:db8:3::1/128 } tcp dport { 53 } accept comment "Resolver guest"
		iifname { "internet" } jump policy-internet-local
		iifname { "eth0" } jump policy-mgmt-local
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		meta sdifname "n64-guest" ip6 saddr 64:ff9b::/96 accept comment "NAT64 guest"
		meta sdifname "n64-guest" ip saddr 169.254.111.206 accept comment "NAT64 guest"
		oifname "n64-guest" ip6 daddr 64:ff9b::/96 accept comment "NAT64 guest"
		ct status dnat accept
		meta sdifname { "eth3" } oifname { "eth4" } jump policy-guest-out
		iifname { "tenant" } oifname { "eth1" } jump policy-tenant-internet
	}
	chain dstnat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "n64-guest" accept comment "NAT64 guest"
		ip6 daddr 64:ff9b::/96 accept comment "NAT64 guest"
		meta nfproto ipv4 iifname { "eth4" } tcp dport { 8080 } dnat ip to 192.0.2.10:80
	}
	chain srcnat {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "n64-guest" accept comment "NAT64 guest"
		ip6 saddr 64:ff9b::/96 accept comment "NAT64 guest"
		ip saddr 169.254.111.206 meta l4proto { tcp, udp } masquerade to :61001-65535 comment "NAT64 guest"
		ip saddr 169.254.111.206 masquerade comment "NAT64 guest"
		meta nfproto ipv4 oifname { "eth4" } masquerade
		meta nfproto ipv4 oifname { "eth1" } masquerade
	}
}
