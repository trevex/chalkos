{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A partition for the node's data.",
  "type": "object",
  "properties": {
    "apiVersion": { "const": "storage.chalkos.dev/v1alpha1" },
    "kind": { "const": "Volume" },
    "metadata": { "type": "object" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disk": { "$ref": "#/$defs/diskRef", "description": "The disk the volume is on." },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["tpm2", "none"], "default": "tpm2", "description": "Encryption of the volume." } }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "description": "Labels | with a pipe."
        },
        "password": {
          "anyOf": [
            {
              "type": "object",
              "properties": { "secretRef": { "type": "object" } },
              "x-chalkos-secret-ref": true
            },
            { "type": "null" }
          ],
          "default": null
        },
        "extra": { "type": "object", "description": "Any fields, as `a|b`." },
        "mode": { "enum": ["l2"], "default": "l2" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "kind": { "type": "string" } },
            "x-chalkos-kubernetes-object": true
          }
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "taints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "effect": { "enum": ["NoSchedule", "NoExecute"] },
              "key": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "diskRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "path": { "type": "string", "description": "Path below /dev, as <path>." } }
    }
  },
  "x-chalkos-kind": { "group": "storage.chalkos.dev", "version": "v1alpha1", "kind": "Volume", "multiple": true }
}
