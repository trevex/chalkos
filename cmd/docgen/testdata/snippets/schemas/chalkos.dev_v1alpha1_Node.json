{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "chalkos.dev/v1alpha1" },
    "kind": { "const": "Node" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageRef"],
      "properties": { "imageRef": { "type": "string", "minLength": 1 } }
    }
  },
  "x-chalkos-kind": { "group": "chalkos.dev", "version": "v1alpha1", "kind": "Node", "multiple": false }
}
