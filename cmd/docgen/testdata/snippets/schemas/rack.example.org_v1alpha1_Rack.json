{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "rack.example.org/v1alpha1" },
    "kind": { "const": "Rack" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": { "location": { "type": "string", "minLength": 1 } }
    }
  },
  "x-chalkos-kind": { "group": "rack.example.org", "version": "v1alpha1", "kind": "Rack", "multiple": false }
}
