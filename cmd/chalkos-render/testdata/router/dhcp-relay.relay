# dnsmasq-relay-guest.conf
# dnsmasq's DHCP relay of the VRF guest, rendered by chalkos-render. It relays the requests of
# the clients on its links to the servers, and serves neither DHCP nor DNS.
port=0
no-resolv
no-hosts
quiet-dhcp
quiet-dhcp6
interface=vlan20
dhcp-relay=198.51.100.1,203.0.113.54
# dnsmasq-relay.conf
# dnsmasq's DHCP relay of the VRF default, rendered by chalkos-render. It relays the requests of
# the clients on its links to the servers, and serves neither DHCP nor DNS.
port=0
no-resolv
no-hosts
quiet-dhcp
quiet-dhcp6
interface=lan0
dhcp-relay=192.0.2.1,203.0.113.53
dhcp-relay=2001:db8:1::1,2001:db8:ff::53
