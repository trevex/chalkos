# 00-vrf-access.netdev
[NetDev]
Kind=vrf
Name=access

[VRF]
Table=500

# 00-vrf-access.network
[Match]
Name=access

[Link]
RequiredForOnline=no

[Route]
Destination=0.0.0.0/0
Metric=4278198272
Table=500
Type=unreachable

[Route]
Destination=::/0
Metric=4278198272
Table=500
Type=unreachable

# 10-lan0.network
[Match]
Name=lan0

[IPv6Prefix]
Prefix=2001:db8:1::/64

[IPv6SendRA]
Managed=true

[Network]
Address=2001:db8:1::1/64
IPv6AcceptRA=false
IPv6SendRA=true

# 20-cust0.network
[Match]
Name=cust0

[IPv6Prefix]
Prefix=2001:db8:2::/64

[IPv6SendRA]
OtherInformation=true

[Network]
Address=2001:db8:2::1/64
IPv6AcceptRA=false
IPv6SendRA=true
VRF=access

