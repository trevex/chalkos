# The router's firewall, rendered by chalkos-render. Loading the file replaces the table
# inet chalkos in one transaction.
table inet chalkos
delete table inet chalkos
table inet chalkos {
	set addresses-office {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { 2001:db8:1::/48, 2001:db8:1:2::/64 }
	}
	chain policy-fabric-wan {
		accept
	}
	chain policy-wan-local {
		ip6 saddr @addresses-office tcp dport { 22 } log prefix "wan-local 1: " accept
		udp sport { 123 } udp dport { 1024-65535 } accept
		ip saddr { 192.0.2.0/24 } reject with icmpx admin-prohibited
		ip6 saddr { 2001:db8:ffff::/48 } reject with icmpx admin-prohibited
		drop
	}
	chain prerouting {
		type filter hook prerouting priority mangle + 10; policy drop;
		meta nfproto ipv4 udp sport . udp dport { 67 . 68, 68 . 67 } accept
		fib saddr . mark oif exists accept
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		ct state established,related accept
		ct state invalid drop
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } accept
		ip6 daddr fe80::/64 udp sport 547 udp dport 546 accept
		iifname { "eth0" } tcp dport 50000 accept
		iifname { "eth1", "eth2" } tcp dport { 179 } accept comment "BGPPeer fabric"
		iifname { "eth1", "eth2" } udp dport { 3784, 3785 } accept comment "BGPPeer fabric"
		ip saddr { 203.0.113.254/32 } tcp dport { 179 } accept comment "BGPPeer transit"
		ip6 saddr { 2001:db8::/32 } ip6 daddr { 2001:db8:ffff::1/128 } udp dport { 53 } accept comment "Resolver resolver"
		ip6 saddr { 2001:db8::/32 } ip6 daddr { 2001:db8:ffff::1/128 } tcp dport { 53 } accept comment "Resolver resolver"
		iifname { "eth0" } jump policy-wan-local
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		iifname "n64-edge" ip6 saddr 64:ff9b::/96 accept comment "NAT64 edge"
		iifname "n64-edge" ip saddr { 192.0.2.8/30 } accept comment "NAT64 edge"
		oifname "n64-edge" ip6 daddr 64:ff9b::/96 accept comment "NAT64 edge"
		oifname "n64-edge" ip daddr { 192.0.2.8/30 } accept comment "NAT64 edge"
		ct status dnat accept
		iifname { "eth1", "eth2" } oifname { "eth0" } jump policy-fabric-wan
	}
	chain dstnat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "n64-edge" accept comment "NAT64 edge"
		meta nfproto ipv4 iifname { "eth0" } ip daddr { 203.0.113.1/32 } tcp dport { 80, 443 } dnat ip to 192.0.2.10
	}
	chain srcnat {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "n64-edge" accept comment "NAT64 edge"
		ip saddr { 192.0.2.8/30 } accept comment "NAT64 edge"
		meta nfproto ipv4 oifname { "eth0" } masquerade
	}
}
