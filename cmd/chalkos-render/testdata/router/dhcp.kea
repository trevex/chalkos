# kea-dhcp4-guest.json
{
  "Dhcp4": {
    "control-sockets": [
      {
        "socket-name": "/run/kea/dhcp4-guest.sock",
        "socket-type": "unix"
      }
    ],
    "hooks-libraries": [
      {
        "library": "libdhcp_lease_cmds.so"
      }
    ],
    "interfaces-config": {
      "dhcp-socket-type": "raw",
      "interfaces": [
        "vlan20"
      ],
      "service-sockets-max-retries": 4294967295,
      "service-sockets-retry-wait-time": 5000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "name": "/var/lib/kea/dhcp4-guest.leases",
      "persist": true,
      "type": "memfile"
    },
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p [%c] %m\n"
          }
        ],
        "severity": "INFO"
      },
      {
        "name": "kea-dhcp4.dhcp",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p [%c] %m\n"
          }
        ],
        "severity": "ERROR"
      },
      {
        "name": "kea-dhcp4.commands",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p [%c] %m\n"
          }
        ],
        "severity": "WARN"
      }
    ],
    "subnet4": [
      {
        "id": 3325256704,
        "option-data": [
          {
            "data": "198.51.100.1",
            "name": "routers"
          },
          {
            "data": "198.51.100.1",
            "name": "domain-name-servers"
          }
        ],
        "pools": [
          {
            "pool": "198.51.100.10 - 198.51.100.250"
          }
        ],
        "subnet": "198.51.100.0/24",
        "user-context": {
          "name": "guests"
        },
        "valid-lifetime": 3600
      }
    ]
  }
}
# kea-dhcp4.json
{
  "Dhcp4": {
    "client-classes": [
      {
        "boot-file-name": "http://192.0.2.5/boot.ipxe",
        "name": "office-ipxe",
        "next-server": "192.0.2.5",
        "only-in-additional-list": true,
        "test": "substring(option[77].hex, 0, 4) == 'iPXE'"
      },
      {
        "boot-file-name": "ipxe.efi",
        "name": "office-uefi",
        "next-server": "192.0.2.5",
        "only-in-additional-list": true,
        "test": "not member('office-ipxe') and (option[93].hex == 0x0007 or option[93].hex == 0x0009)"
      },
      {
        "boot-file-name": "undionly.kpxe",
        "name": "office-bios",
        "next-server": "192.0.2.5",
        "only-in-additional-list": true,
        "test": "not member('office-ipxe') and option[93].hex == 0x0000"
      }
    ],
    "control-sockets": [
      {
        "socket-name": "/run/kea/dhcp4.sock",
        "socket-type": "unix"
      }
    ],
    "hooks-libraries": [
      {
        "library": "libdhcp_lease_cmds.so"
      }
    ],
    "interfaces-config": {
      "dhcp-socket-type": "raw",
      "interfaces": [
        "lan0"
      ],
      "service-sockets-max-retries": 4294967295,
      "service-sockets-retry-wait-time": 5000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "name": "/var/lib/kea/dhcp4.leases",
      "persist": true,
      "type": "memfile"
    },
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p [%c] %m\n"
          }
        ],
        "severity": "INFO"
      },
      {
        "name": "kea-dhcp4.dhcp",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p [%c] %m\n"
          }
        ],
        "severity": "ERROR"
      },
      {
        "name": "kea-dhcp4.commands",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p [%c] %m\n"
          }
        ],
        "severity": "WARN"
      }
    ],
    "subnet4": [
      {
        "evaluate-additional-classes": [
          "office-ipxe",
          "office-uefi",
          "office-bios"
        ],
        "id": 3221225984,
        "option-data": [
          {
            "data": "192.0.2.1",
            "name": "routers"
          },
          {
            "data": "192.0.2.1",
            "name": "domain-name-servers"
          },
          {
            "data": "lan.example.org",
            "name": "domain-name"
          },
          {
            "data": "lan.example.org",
            "name": "domain-search"
          }
        ],
        "pools": [
          {
            "pool": "192.0.2.100 - 192.0.2.199"
          }
        ],
        "reservations": [
          {
            "hostname": "printer",
            "hw-address": "52:54:00:12:34:56",
            "ip-address": "192.0.2.10"
          }
        ],
        "subnet": "192.0.2.0/24",
        "user-context": {
          "name": "office"
        },
        "valid-lifetime": 43200
      }
    ]
  }
}
