{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "chalkos.dev/v1alpha1"
    },
    "kind": {
      "const": "Secret"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Secret values by key, which secretRef fields of other documents name.",
          "type": "object"
        }
      },
      "required": [
        "data"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Secret",
  "type": "object",
  "x-chalkos-kind": {
    "group": "chalkos.dev",
    "kind": "Secret",
    "multiple": true,
    "version": "v1alpha1"
  }
}
