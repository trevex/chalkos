{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "chalkos.dev/v1alpha1"
    },
    "kind": {
      "const": "Image"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "additionalProperties": false,
          "properties": {
            "directory": {
              "description": "Directory of an image build, as nix build makes it; a relative path is relative to the directory of the file that holds the document, as the inventory names that file, without following a symlink to it.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "directory"
          ],
          "type": "object"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Image",
  "type": "object",
  "x-chalkos-kind": {
    "group": "chalkos.dev",
    "kind": "Image",
    "multiple": true,
    "version": "v1alpha1"
  }
}
