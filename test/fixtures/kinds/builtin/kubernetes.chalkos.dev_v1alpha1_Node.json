{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "kubernetes.chalkos.dev/v1alpha1"
    },
    "kind": {
      "const": "Node"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "kubeletExtraArgs": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra flags of the kubelet, named without the leading dashes with letters, digits, `_`, `.` and `-`, starting with a letter or digit; they override chalkos's own, except the flags chalkos protects, which are refused.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Kubernetes labels applied to the node.",
          "type": "object"
        },
        "nodeIP": {
          "additionalProperties": false,
          "properties": {
            "addresses": {
              "anyOf": [
                {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Fixed addresses of the node, at most one per family; null takes the first static address of each family unless validSubnets apply."
            },
            "validSubnets": {
              "anyOf": [
                {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Subnets the node picks its address from, which replace the Cluster's nodeIP.validSubnets as a whole; null takes the Cluster's."
            }
          },
          "type": "object"
        },
        "taints": {
          "default": [],
          "description": "Kubernetes taints applied to the node.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "effect": {
                "description": "What happens to pods that do not tolerate the taint.",
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "key": {
                "description": "Taint key.",
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Taint value; null for a taint without a value."
              }
            },
            "required": [
              "effect",
              "key"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "type": {
          "description": "What the node is in the cluster; it is fixed once the node holds a Kubernetes share.",
          "enum": [
            "controlplane",
            "worker"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Node",
  "type": "object",
  "x-chalkos-kind": {
    "group": "kubernetes.chalkos.dev",
    "kind": "Node",
    "multiple": false,
    "rules": [
      {
        "messageExpression": "cel.bind(type, documents.map(n, documents[n].spec.type)[0],\n  \"the config changes the node's type from \\\"\" + facts.share.kind + \"\\\" to \\\"\" + type\n  + \"\\\"; a node keeps its type once it holds a Kubernetes share, so keep it, or reinstall the node as a \" + type)\n",
        "rule": "facts.share == null || documents.all(n, documents[n].spec.type == facts.share.kind)",
        "takes": "refuse"
      }
    ],
    "version": "v1alpha1"
  }
}
