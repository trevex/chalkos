{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "chalkos.dev/v1alpha1"
    },
    "kind": {
      "const": "Cluster"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "pattern": "^(?:https://.+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of the cluster's Kubernetes API server."
        }
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Cluster",
  "type": "object",
  "x-chalkos-kind": {
    "group": "chalkos.dev",
    "kind": "Cluster",
    "multiple": false,
    "version": "v1alpha1"
  }
}
