{
  "schemaVersion": 0,
  "cluster": {
    "name": "homelab",
    "endpoint": "https://10.0.0.10:6443"
  },
  "roles": {
    "controlplane": { "image": "roles.controlplane.image" },
    "worker": { "image": "roles.worker.image" }
  },
  "nodes": {
    "cp1": {
      "role": "controlplane",
      "identity": {
        "hostname": "cp1",
        "network": {
          "networks": {
            "10-uplink": {
              "matchConfig": { "Name": "enp1s0" },
              "address": ["10.0.0.11/24"],
              "gateway": ["10.0.0.1"]
            }
          }
        },
        "labels": {},
        "taints": [],
        "extensions": { "rack": { "location": "rack-a/u12" } }
      }
    },
    "w1": {
      "role": "worker",
      "identity": {
        "hostname": "w1",
        "network": {},
        "labels": { "node.kubernetes.io/storage": "ssd" },
        "taints": [{ "key": "dedicated", "value": "storage", "effect": "NoSchedule" }],
        "extensions": { "rack": { "location": "rack-a/u14" } }
      }
    }
  }
}
