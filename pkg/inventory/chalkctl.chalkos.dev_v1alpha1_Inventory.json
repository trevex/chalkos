{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory",
  "description": "The nodes of a cluster, where chalkctl reaches each, and the config files each gets. Paths are relative to the inventory's directory; globs are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "chalkctl.chalkos.dev/v1alpha1" },
    "kind": { "const": "Inventory" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "string",
          "minLength": 1,
          "description": "The secrets file; default secrets.age, else secrets.json, beside the inventory."
        },
        "secureBoot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signerCertificate"],
          "properties": {
            "signerCertificate": {
              "type": "string",
              "minLength": 1,
              "description": "PEM certificate of the Secure Boot db key the nodes' images must be signed with."
            }
          }
        },
        "files": { "$ref": "#/$defs/files", "description": "Config files every node gets." },
        "groups": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files": { "$ref": "#/$defs/files", "description": "Config files the group's nodes get." }
            }
          }
        },
        "nodes": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "string",
                "minLength": 1,
                "description": "Where chalkctl reaches the node's chalkd: a host or host:port."
              },
              "groups": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "description": "Groups whose files the node gets, in this order."
              },
              "files": { "$ref": "#/$defs/files", "description": "The node's own config files." }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "files": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "x-chalkos-kind": {
    "group": "chalkctl.chalkos.dev",
    "version": "v1alpha1",
    "kind": "Inventory",
    "multiple": false
  }
}
